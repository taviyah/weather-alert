<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- API 33+ makes notifications an opt-in runtime permission; without it every alert this
         app produces is silently dropped. Requested on first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Re-arms the periodic forecast check after a reboot. WorkManager handles this itself, but
         only if the receiver permission is declared. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Android demotes apps you never open into the RARE standby bucket and defers their background
      work to roughly once a day. An alert app is by definition never opened, so without this
      exemption it decays into exactly the state that stops it working. Requested from a banner on
      the home screen, never silently.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- KeepAliveService. On DuraSpeed phones (Bigme and other MediaTek builds) an app without a
         foreground service is force-stopped minutes after leaving the screen, which deletes its
         scheduled checks. See KeepAliveService for the measured evidence. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Optional, only for the "use my location" button. Coarse is plenty: the forecast grid is
         about 11 km wide, so a finer fix would buy nothing. The app is fully usable without it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Backup is on deliberately: the watched places and settings then follow the user to a
         new phone through their own Google backup. Nothing else is stored. -->
    <application
        android:name=".WeatherAlertApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeatherAlert">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".work.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps periodic weather-alert checks from being force-stopped by OEM background killers" />
        </service>

        <receiver
            android:name=".work.KeepAliveStarter"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          The widget never polls: updatePeriodMillis is 0 and refreshes are pushed by the worker
          after a check that changed something.
        -->
        <receiver
            android:name=".widget.WeatherWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
